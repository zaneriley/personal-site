{
  "schema_version": 1,
  "profile": {
    "name": "mobile-cold",
    "device": "Pixel 5"
  },
  "required_metrics": [
    "readable_content_ms",
    "dom_content_loaded_ms",
    "load_ms"
  ],
  "defaults": {
    "main_selector": "main",
    "timeout_ms": 15000,
    "settle_ms": 500,
    "allowed_statuses": [200],
    "max_total_bytes": 120000,
    "max_html_bytes": 60000,
    "max_css_bytes": 50000,
    "max_js_bytes": 120000,
    "max_font_bytes": 100000,
    "max_image_bytes": 150000,
    "max_websocket_bytes": 25000,
    "max_request_count": 12,
    "max_readable_content_ms": 1000,
    "max_dom_content_loaded_ms": 1000,
    "max_load_ms": 1800,
    "max_fcp_ms": 1800,
    "max_cls": 0.1
  },
  "routes": [
    {
      "label": "root",
      "path": "/"
    },
    {
      "label": "english-home",
      "path": "/en"
    },
    {
      "label": "case-studies-index",
      "path": "/en/case-studies"
    },
    {
      "label": "prod-build-case-study",
      "path": "/en/case-study/prod-build-smoke-case-study"
    },
    {
      "label": "notes-index",
      "path": "/en/notes"
    },
    {
      "label": "prod-build-note",
      "path": "/en/note/prod-build-smoke-note"
    },
    {
      "label": "japanese-home",
      "path": "/ja"
    }
  ],
  "exceptions": []
}
