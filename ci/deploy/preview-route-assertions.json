{
  "schema_version": 1,
  "viewports": [
    {
      "label": "desktop",
      "width": 1280,
      "height": 720
    },
    {
      "label": "mobile",
      "device": "iPhone SE"
    }
  ],
  "browser_defaults": {
    "required_dom": ["main"],
    "require_live_view": true,
    "require_share_metadata": true,
    "screenshot": true
  },
  "text_policy": {
    "forbidden_visible_text": [
      "We ran into an issue loading this note",
      "We ran into an issue loading this case study",
      "We encountered an error while preparing",
      "Phoenix.Router.NoRouteError",
      "Plug.Conn.WrapperError",
      "preview.local"
    ],
    "forbidden_html_text": [
      "localhost",
      "127.0.0.1",
      "0.0.0.0",
      "web:8000"
    ]
  },
  "routes": [
    {
      "label": "root",
      "path": "/",
      "allowed_statuses": [200],
      "required_body_text": ["Digital Product Designer", "Tokyo"],
      "browser": {
        "required_visible_text": ["Digital Product Designer", "Tokyo"]
      }
    },
    {
      "label": "english-home",
      "path": "/en",
      "allowed_statuses": [200],
      "required_body_text": ["Digital Product Designer", "Tokyo"],
      "browser": {
        "required_visible_text": ["Digital Product Designer", "Tokyo"]
      }
    },
    {
      "label": "japanese-home",
      "path": "/ja",
      "allowed_statuses": [200],
      "required_body_text": ["プロダクトデザイナー", "東京"],
      "browser": {
        "required_visible_text": ["プロダクトデザイナー", "東京"]
      }
    },
    {
      "label": "notes-index",
      "path": "/en/notes",
      "allowed_statuses": [200],
      "required_body_text": ["Listing Notes"],
      "browser": {
        "required_visible_text": ["Listing Notes"]
      }
    },
    {
      "label": "case-studies-index",
      "path": "/en/case-studies",
      "allowed_statuses": [200],
      "required_body_text": ["Case Studies"],
      "browser": {
        "required_visible_text": ["Case Studies"]
      }
    },
    {
      "label": "prod-build-note",
      "path": "/en/note/prod-build-smoke-note",
      "allowed_statuses": [200],
      "required_body_text": ["Prod Build Smoke Note"],
      "browser": {
        "required_visible_text": ["Prod Build Smoke Note"]
      }
    },
    {
      "label": "prod-build-case-study",
      "path": "/en/case-study/prod-build-smoke-case-study",
      "allowed_statuses": [200],
      "required_body_text": ["Prod Build Smoke Case Study"],
      "browser": {
        "required_visible_text": ["Prod Build Smoke Case Study"]
      }
    },
    {
      "label": "readyz",
      "path": "/readyz",
      "allowed_statuses": [200],
      "required_body_text": ["ok"],
      "browser": {
        "enabled": false
      }
    },
    {
      "label": "missing-note",
      "path": "/en/note/this-route-cannot-exist-xyzzy",
      "allowed_statuses": [404],
      "required_body_text": ["Not Found"],
      "browser": {
        "enabled": false
      }
    }
  ]
}
