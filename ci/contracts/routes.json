{
  "schema_version": 1,
  "text_policy": {
    "forbidden_visible_text": [
      "We ran into an issue loading this note",
      "We ran into an issue loading this case study",
      "We encountered an error while preparing",
      "Phoenix.Router.NoRouteError",
      "Plug.Conn.WrapperError",
      "preview.local"
    ],
    "forbidden_html_text": [
      "localhost",
      "127.0.0.1",
      "0.0.0.0",
      "web:8000",
      "http://zaneriley.com",
      "https://zaneriley.com",
      "http://www.zaneriley.com",
      "https://www.zaneriley.com",
      "//zaneriley.com",
      "//www.zaneriley.com"
    ]
  },
  "browser": {
    "viewports": [
      {
        "label": "desktop",
        "width": 1280,
        "height": 720
      },
      {
        "label": "mobile",
        "device": "iPhone SE"
      }
    ],
    "defaults": {
      "required_dom": ["main"],
      "require_live_view": true,
      "require_share_metadata": true,
      "screenshot": true
    }
  },
  "performance": {
    "_contract": "ADR 0006: the goal is readable_content_ms <= 1000 cold on the throttled profile below. Byte budgets are never-worse-than-now ratchets: tighten when a saving lands, never raise to make a run green. Dated entries in `exceptions` are the only sanctioned way to carry a known overrun.",
    "profile": {
      "name": "mobile-cold",
      "device": "Pixel 5",
      "network": {
        "download_kbps": 9000,
        "upload_kbps": 1500,
        "latency_ms": 100
      },
      "cpu_throttle_rate": 4,
      "timing_samples": 3
    },
    "required_metrics": [
      "readable_content_ms",
      "dom_content_loaded_ms",
      "load_ms"
    ],
    "defaults": {
      "main_selector": "main",
      "timeout_ms": 15000,
      "settle_ms": 500,
      "allowed_statuses": [200],
      "max_total_bytes": 525000,
      "max_html_bytes": 15000,
      "max_css_bytes": 10000,
      "max_js_bytes": 52000,
      "max_font_bytes": 380000,
      "max_image_bytes": 76000,
      "max_request_count": 11,
      "max_readable_content_ms": 1000,
      "max_dom_content_loaded_ms": 700,
      "max_load_ms": 1000,
      "max_fcp_ms": 800,
      "max_cls": 0.1
    },
    "exceptions": []
  },
  "routes": [
    {
      "label": "root",
      "path": "/",
      "allowed_statuses": [200],
      "required_body_text": ["Product designer", "Tokyo"],
      "browser": {
        "required_visible_text": ["Product designer", "Tokyo"]
      }
    },
    {
      "label": "english-home",
      "path": "/en",
      "allowed_statuses": [200],
      "required_body_text": ["Product designer", "Tokyo"],
      "browser": {
        "required_visible_text": ["Product designer", "Tokyo"]
      }
    },
    {
