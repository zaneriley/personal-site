{
  "schema_version": 1,
  "text_policy": {
    "forbidden_visible_text": [
      "We ran into an issue loading this note",
      "We ran into an issue loading this case study",
      "We encountered an error while preparing",
      "Phoenix.Router.NoRouteError",
      "Plug.Conn.WrapperError",
      "preview.local"
    ],
    "forbidden_html_text": [
      "localhost",
      "127.0.0.1",
      "0.0.0.0",
      "web:8000",
      "zaneriley.com"
    ]
  },
  "browser": {
    "viewports": [
      {
        "label": "desktop",
        "width": 1280,
        "height": 720
      },
      {
        "label": "mobile",
        "device": "iPhone SE"
      }
    ],
    "defaults": {
      "required_dom": ["main"],
      "require_live_view": true,
      "require_share_metadata": true,
      "screenshot": true
    }
  },
  "performance": {
    "profile": {
      "name": "mobile-cold",
      "device": "Pixel 5"
    },
    "required_metrics": [
      "readable_content_ms",
      "dom_content_loaded_ms",
      "load_ms"
    ],
    "defaults": {
      "main_selector": "main",
      "timeout_ms": 15000,
      "settle_ms": 500,
      "allowed_statuses": [200],
      "max_total_bytes": 120000,
      "max_html_bytes": 60000,
      "max_css_bytes": 50000,
      "max_js_bytes": 120000,
      "max_font_bytes": 100000,
      "max_image_bytes": 150000,
      "max_websocket_bytes": 25000,
      "max_request_count": 12,
      "max_readable_content_ms": 1000,
      "max_dom_content_loaded_ms": 1000,
      "max_load_ms": 1800,
      "max_fcp_ms": 1800,
      "max_cls": 0.1
    },
    "exceptions": []
  },
  "routes": [
    {
      "label": "root",
      "path": "/",
      "allowed_statuses": [200],
      "required_body_text": ["Digital Product Designer", "Tokyo"],
      "browser": {
        "required_visible_text": ["Digital Product Designer", "Tokyo"]
      }
    },
    {
