#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

DEFAULT_FIXTURE_ROOT="test/fixtures/ci/acceptance-gate-bypass"

# These are the required ci:* acceptance gates. Deleting a task from run must
# fail the checker; it must not silently remove the workflow requirement.
CANONICAL_ACCEPTANCE_GATES=(
  "ci:compile"
  "ci:lint"
  "ci:workflow-lint"
  "ci:security-check"
  "ci:test"
  "ci:static-analysis"
  "ci:secret-scan"
  "ci:acceptance-gate-bypass-check"
  "ci:acceptance-gate-bypass-check:test"
)

ISSUES=()
FUNCTION_NAMES=()
REACHABLE_FUNCTIONS=()
REQUIRED_GATES=()
WORKFLOW_ACTIVE_TEXT=""
CURRENT_JOB_ID=""
CURRENT_JOB_NAME=""
CURRENT_JOB_LINE=0
CURRENT_JOB_STAGE_KEYS=()

function usage {
  cat <<'USAGE'
Usage:
  bin/ci/acceptance-gate-bypass-check
  bin/ci/acceptance-gate-bypass-check --check <repo-or-fixture-case>
  bin/ci/acceptance-gate-bypass-check --test-fixtures [fixture-root]

Checks GitHub workflow acceptance gates for fake-green bypasses:
continue-on-error, warning-only fallbacks, set +e, suppression flags, raw
tool replacements, skipped/narrowed/proxy gates, and gate-like workflow
steps that omit ./run.
USAGE
}

function trim {
  local value="$*"

  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"

  printf "%s" "${value}"
}

function unquote {
  local value

  value="$(trim "$*")"
  value="${value%\"}"
  value="${value#\"}"
  value="${value%\'}"
  value="${value#\'}"

  printf "%s" "${value}"
}

function lower {
  printf "%s" "$*" | tr '[:upper:]' '[:lower:]'
}

function normalize_stage_name {
  local value

  value="$(lower "$(unquote "$*")")"
  value="$(printf "%s" "${value}" | tr ' _' '--')"

  printf "%s" "${value}"
}

function clean_line {
  local line="$1"
  local trimmed

  trimmed="$(trim "${line}")"

  if [[ -z "${trimmed}" || "${trimmed}" == \#* ]]; then
    return 0
  fi

  line="${line%% #*}"
  printf "%s" "${line}"
}

function add_issue {
  local file="$1"
  local line="$2"
  local message="$3"

  ISSUES+=("${file}:${line}: ${message}")
}

function value_in_list {
  local candidate="$1"
  shift
  local value

  for value in "$@"; do
    if [[ "${candidate}" == "${value}" ]]; then
      return 0
    fi
  done

  return 1
}

function gate_is_defined {
  local run_file="$1"
  local gate="$2"

  grep -Eq "^[[:space:]]*function[[:space:]]+${gate}[[:space:]]*\\{" "${run_file}"
}

function collect_function_names {
  local run_file="$1"
  local line

  FUNCTION_NAMES=()

  while IFS= read -r line || [[ -n "${line}" ]]; do
    if [[ "${line}" =~ ^[[:space:]]*function[[:space:]]+([A-Za-z_][A-Za-z0-9_:-]*)[[:space:]]*\{ ]]; then
      FUNCTION_NAMES+=("${BASH_REMATCH[1]}")
    fi
  done < "${run_file}"
}

function active_line_invokes_function {
  local active="$1"
  local function_name="$2"

  [[ "${active}" =~ (^|[[:space:];|&])${function_name}([[:space:];|&]|$) ]]
}

function collect_reachable_functions {
  local run_file="$1"
  local line
  local active
  local function_name=""
  local in_function=0
  local changed=1
  local candidate

  REACHABLE_FUNCTIONS=()

  for candidate in "${FUNCTION_NAMES[@]}"; do
    if [[ "${candidate}" == ci:* ]]; then
      REACHABLE_FUNCTIONS+=("${candidate}")
    fi
  done

  while (( changed )); do
    changed=0
    in_function=0
    function_name=""

    while IFS= read -r line || [[ -n "${line}" ]]; do
      if [[ "${line}" =~ ^[[:space:]]*function[[:space:]]+([A-Za-z_][A-Za-z0-9_:-]*)[[:space:]]*\{ ]]; then
        in_function=1
        function_name="${BASH_REMATCH[1]}"
        continue
      fi

      if (( in_function )) && [[ "${line}" =~ ^[[:space:]]*\} ]]; then
        in_function=0
        function_name=""
        continue
      fi

      if ! (( in_function )) || ! value_in_list "${function_name}" "${REACHABLE_FUNCTIONS[@]}"; then
        continue
      fi

      active="$(clean_line "${line}")"
      [[ -n "${active}" ]] || continue

      for candidate in "${FUNCTION_NAMES[@]}"; do
        if ! value_in_list "${candidate}" "${REACHABLE_FUNCTIONS[@]}" && active_line_invokes_function "${active}" "${candidate}"; then
          REACHABLE_FUNCTIONS+=("${candidate}")
          changed=1
        fi
      done
    done < "${run_file}"
  done
}

function collect_required_gates {
  local run_file="$1"
  local gate

  REQUIRED_GATES=()

  for gate in "${CANONICAL_ACCEPTANCE_GATES[@]}"; do
    REQUIRED_GATES+=("${gate}")

    if ! gate_is_defined "${run_file}" "${gate}"; then
      add_issue "${run_file}" "0" "missing required run task: function ${gate}"
    fi
  done
}

function is_required_gate {
  local candidate="$1"
  local gate

  for gate in "${REQUIRED_GATES[@]}"; do
    if [[ "${candidate}" == "${gate}" ]]; then
      return 0
    fi
  done

  return 1
}

function expected_gate_for_step_name {
  local name

  name="$(lower "$(unquote "$1")")"

  if [[ -z "${name}" ]]; then
    return 0
  fi

  if { [[ "${name}" == *"acceptance"* && "${name}" == *"bypass"* ]] || [[ "${name}" == *"gate bypass"* ]]; } \
    && { [[ "${name}" == *"fixture"* || "${name}" == *"matrix"* || "${name}" == *"test"* ]]; }; then
    printf "%s" "ci:acceptance-gate-bypass-check:test"
  elif [[ "${name}" == *"acceptance"* && "${name}" == *"bypass"* ]] || [[ "${name}" == *"gate bypass"* ]]; then
    printf "%s" "ci:acceptance-gate-bypass-check"
  elif [[ "${name}" == *"workflow lint"* || "${name}" == *"actionlint"* ]]; then
    printf "%s" "ci:workflow-lint"
  elif [[ "${name}" == *"secret scan"* ]]; then
    printf "%s" "ci:secret-scan"
  elif [[ "${name}" == *"static analysis"* || "${name}" == *"dialyzer"* ]]; then
    printf "%s" "ci:static-analysis"
  elif [[ "${name}" == *"security check"* || "${name}" == *"sobelow"* ]]; then
    printf "%s" "ci:security-check"
  elif [[ "${name}" == *"test"* || "${name}" == *"vitest"* ]]; then
    printf "%s" "ci:test"
  elif [[ "${name}" == *"compile"* ]]; then
    printf "%s" "ci:compile"
  elif [[ "${name}" == *"lint"* || "${name}" == *"credo"* || "${name}" == *"biome"* || "${name}" == *"stylelint"* || "${name}" == *"shellcheck"* || "${name}" == *"hadolint"* ]]; then
    printf "%s" "ci:lint"
  fi
}

function text_has_exact_gate {
  local text="$1"
  local gate="$2"

  printf "%s\n" "${text}" | grep -Eq "\\./run[[:space:]]+${gate}([[:space:]#]|$)"
}

function first_run_gate {
  local text="$1"
  local line

  while IFS= read -r line || [[ -n "${line}" ]]; do
    if [[ "${line}" =~ (^|[[:space:]])\./run[[:space:]]+(ci:[A-Za-z0-9_:-]+) ]]; then
      printf "%s" "${BASH_REMATCH[2]}"
      return 0
    fi
  done <<< "${text}"
}

function stage_key_for_gate {
  case "$1" in
    "ci:workflow-lint")
      printf "%s" "workflow-lint"
      ;;
    "ci:acceptance-gate-bypass-check" | "ci:acceptance-gate-bypass-check:test")
      printf "%s" "gate-integrity"
      ;;
    "ci:compile")
      printf "%s" "compile"
      ;;
    "ci:lint")
      printf "%s" "lint"
      ;;
    "ci:security-check")
      printf "%s" "security-check"
      ;;
    "ci:test")
      printf "%s" "test"
      ;;
    "ci:static-analysis")
      printf "%s" "static-analysis"
      ;;
    "ci:secret-scan")
      printf "%s" "gitleaks"
      ;;
  esac
}

function join_values {
  local value
  local joined=""

  for value in "$@"; do
    if [[ -z "${joined}" ]]; then
      joined="${value}"
    else
      joined="${joined}, ${value}"
    fi
  done

  printf "%s" "${joined}"
}

function current_job_check_name {
  if [[ -n "${CURRENT_JOB_NAME}" ]]; then
    printf "%s" "${CURRENT_JOB_NAME}"
  else
    printf "%s" "${CURRENT_JOB_ID}"
  fi
}

function add_current_job_stage_key {
  local stage_key="$1"

  if [[ -z "${stage_key}" ]]; then
    return 0
  fi

  if [[ "${#CURRENT_JOB_STAGE_KEYS[@]}" -eq 0 ]] || ! value_in_list "${stage_key}" "${CURRENT_JOB_STAGE_KEYS[@]}"; then
    CURRENT_JOB_STAGE_KEYS+=("${stage_key}")
  fi
}

function finish_current_workflow_job {
  local file="$1"
  local job_check_name
  local stage_list

  if [[ -z "${CURRENT_JOB_ID}" ]]; then
    return 0
  fi

  if [[ "${#CURRENT_JOB_STAGE_KEYS[@]}" -gt 1 ]]; then
    job_check_name="$(current_job_check_name)"
    stage_list="$(join_values "${CURRENT_JOB_STAGE_KEYS[@]}")"
    add_issue "${file}" "${CURRENT_JOB_LINE}" "job '${job_check_name}' bundles acceptance gate stages (${stage_list}); split them into dedicated GitHub check jobs"
  fi

  CURRENT_JOB_ID=""
  CURRENT_JOB_NAME=""
  CURRENT_JOB_LINE=0
  CURRENT_JOB_STAGE_KEYS=()
}

function line_has_suppression_flag {
  local line

  line="$(lower "$1")"

  case "${line}" in
    *"--ignore"*|\
    *"--allow-fail"*|\
    *"--allow_failure"*|\
    *"--continue-on-error"*|\
    *"--exit-zero"*|\
    *"--no-fail"*|\
    *"--no-error"*|\
    *"--baseline"*|\
    *"--suppress"*|\
    *"--skip"*|\
    *"--only"*|\
    *"--changed"*)
      return 0
      ;;
  esac

  return 1
}

function scan_workflow_job_legibility {
  local file="$1"
  local display_file="$1"
  local line
  local line_number=0
  local in_jobs=0
  local active
  local gate
  local expected_stage
  local job_check_name
  local normalized_job_check_name

  CURRENT_JOB_ID=""
  CURRENT_JOB_NAME=""
  CURRENT_JOB_LINE=0
  CURRENT_JOB_STAGE_KEYS=()

  while IFS= read -r line || [[ -n "${line}" ]]; do
    line_number=$((line_number + 1))
    active="$(clean_line "${line}")"

    if [[ "${line}" =~ ^jobs:[[:space:]]*$ ]]; then
      in_jobs=1
      continue
    fi

    if (( in_jobs )) && [[ "${line}" =~ ^[^[:space:]][A-Za-z0-9_-]+:[[:space:]]* ]]; then
      finish_current_workflow_job "${display_file}"
      in_jobs=0
    fi

    if ! (( in_jobs )); then
      continue
    fi

    if [[ "${line}" =~ ^[[:space:]]{2}([A-Za-z0-9_-]+):[[:space:]]*$ ]]; then
      finish_current_workflow_job "${display_file}"
      CURRENT_JOB_ID="${BASH_REMATCH[1]}"
      CURRENT_JOB_NAME=""
      CURRENT_JOB_LINE="${line_number}"
      CURRENT_JOB_STAGE_KEYS=()
      continue
    fi

    if [[ -n "${CURRENT_JOB_ID}" && "${line}" =~ ^[[:space:]]{4}name:[[:space:]]*(.*)$ ]]; then
      CURRENT_JOB_NAME="$(unquote "${BASH_REMATCH[1]}")"
      continue
    fi

    if [[ -z "${CURRENT_JOB_ID}" ]]; then
      continue
    fi

    if [[ "${active}" =~ (^|[[:space:]])\./run[[:space:]]+(ci:[A-Za-z0-9_:-]+)([[:space:]]|$) ]]; then
      gate="${BASH_REMATCH[2]}"

      if is_required_gate "${gate}"; then
        expected_stage="$(stage_key_for_gate "${gate}")"
        add_current_job_stage_key "${expected_stage}"

        job_check_name="$(current_job_check_name)"
        normalized_job_check_name="$(normalize_stage_name "${job_check_name}")"

        if [[ -n "${expected_stage}" && "${normalized_job_check_name}" != "${expected_stage}" ]]; then
          add_issue "${display_file}" "${line_number}" "required gate ./run ${gate} must run in GitHub check job '${expected_stage}', not '${job_check_name}'"
        fi
      fi
    fi
  done < "${file}"

  finish_current_workflow_job "${display_file}"
}

function scan_run_invocation {
  local file="$1"
  local line_number="$2"
  local active="$3"
  local invoked
  local rest
  local extra
  local gate

  if [[ ! "${active}" =~ (^|[[:space:]])\./run[[:space:]]+(ci:[A-Za-z0-9_:-]+)([[:space:]]+.*)?$ ]]; then
    return 0
  fi

  invoked="${BASH_REMATCH[2]}"
  rest="${BASH_REMATCH[3]:-}"
  extra="$(trim "${rest}")"

  if [[ "${invoked}" == "ci:run-all" ]]; then
    add_issue "${file}" "${line_number}" "workflow uses proxy gate ./run ci:run-all; call each required ./run ci:* gate directly"
  fi

  for gate in "${REQUIRED_GATES[@]}"; do
    if ! is_required_gate "${invoked}" && [[ "${invoked}" == "${gate}:"* ]]; then
      add_issue "${file}" "${line_number}" "workflow uses narrowed gate ${invoked}; call ./run ${gate} directly"
    fi
  done

  if is_required_gate "${invoked}" && [[ -n "${extra}" ]]; then
    add_issue "${file}" "${line_number}" "required gate ./run ${invoked} must not receive extra args or shell chaining"
  fi
}

function scan_policy_line {
  local file="$1"
  local line_number="$2"
  local raw_line="$3"
  local scan_raw_tools="$4"
  local active
  local active_lower

  active="$(clean_line "${raw_line}")"

  if [[ -z "${active}" ]]; then
    return 0
  fi

  active_lower="$(lower "${active}")"

  if [[ "${active_lower}" =~ continue-on-error[[:space:]]*: ]] && [[ ! "${active_lower}" =~ continue-on-error[[:space:]]*:[[:space:]]*false([[:space:]#]|$) ]]; then
    add_issue "${file}" "${line_number}" "continue-on-error is forbidden on acceptance gates"
  fi

  if [[ "${active_lower}" == *"set +e"* ]]; then
    add_issue "${file}" "${line_number}" "set +e is forbidden around acceptance gates"
  fi

  if [[ "${active_lower}" =~ \|\|[[:space:]]*true([^[:alnum:]_:-]|$) ]]; then
    add_issue "${file}" "${line_number}" "|| true is forbidden on acceptance gates"
  fi

  if [[ "${active_lower}" =~ \|\|[[:space:]]*(echo|printf|warn|notice|:|exit[[:space:]]+0) ]]; then
    add_issue "${file}" "${line_number}" "warning-only fallback is forbidden on acceptance gates"
  fi

  if [[ "${active_lower}" =~ ^[[:space:]]*if:[[:space:]]*(\$\{\{[[:space:]]*)?false ]]; then
    add_issue "${file}" "${line_number}" "skipping an acceptance-gate step with if: false is forbidden"
  fi

  if line_has_suppression_flag "${active_lower}"; then
    add_issue "${file}" "${line_number}" "broad ignore/suppression/narrowing flag is forbidden on required gates"
  fi

  if (( scan_raw_tools )) \
    && [[ "${active_lower}" =~ (^|[[:space:];|&])(actionlint|biome|credo|dialyzer|gitleaks|hadolint|mix|npx|shellcheck|sobelow|stylelint|vitest|yarn)[[:space:]]+ ]] \
    && [[ ! "${active_lower}" =~ ^[[:space:]]*(actionlint|biome|credo|dialyzer|gitleaks|hadolint|mix|npx|shellcheck|sobelow|stylelint|vitest|yarn)[[:space:]]+(--version|version)([[:space:]#]|$) ]]; then
    add_issue "${file}" "${line_number}" "raw tool workflow command bypasses ./run ci:*"
  fi

  scan_run_invocation "${file}" "${line_number}" "${active}"
}

function extract_step_name {
  local text="$1"
  local line
  local name

  while IFS= read -r line || [[ -n "${line}" ]]; do
    if [[ "${line}" =~ ^[[:space:]]*-[[:space:]]*name:[[:space:]]*(.*)$ ]]; then
      name="${BASH_REMATCH[1]}"
      unquote "${name}"
      return 0
    elif [[ "${line}" =~ ^[[:space:]]*name:[[:space:]]*(.*)$ ]]; then
      name="${BASH_REMATCH[1]}"
      unquote "${name}"
      return 0
    fi
  done <<< "${text}"
}

function scan_workflow_step {
  local file="$1"
  local start_line="$2"
  local text="$3"
  local step_name
  local expected_gate
  local called_gate
  local active_text=""
  local line
  local offset=0

  while IFS= read -r line || [[ -n "${line}" ]]; do
    local active

    active="$(clean_line "${line}")"
    if [[ -n "${active}" ]]; then
      active_text+="${active}"$'\n'
    fi

    scan_policy_line "${file}" "$((start_line + offset))" "${line}" 1
    offset=$((offset + 1))
  done <<< "${text}"

  step_name="$(extract_step_name "${text}")"
  expected_gate="$(expected_gate_for_step_name "${step_name}")"

  if [[ -n "${expected_gate}" ]] && ! text_has_exact_gate "${active_text}" "${expected_gate}"; then
    called_gate="$(first_run_gate "${active_text}")"

    if [[ -n "${called_gate}" ]]; then
      add_issue "${file}" "${start_line}" "step '${step_name}' looks like ${expected_gate} but calls ./run ${called_gate}"
    else
      add_issue "${file}" "${start_line}" "step '${step_name}' must call ./run ${expected_gate}"
    fi
  fi
}

function scan_workflow_file {
  local file="$1"
  local display_file="$1"
  local line
  local line_number=0
  local in_step=0
  local step_start=0
  local step_text=""

  while IFS= read -r line || [[ -n "${line}" ]]; do
    local active
    local active_lower

    line_number=$((line_number + 1))
    active="$(clean_line "${line}")"
    active_lower="$(lower "${active}")"

    if [[ -n "${active}" ]]; then
      WORKFLOW_ACTIVE_TEXT+="${active}"$'\n'
    fi

    if ! (( in_step )); then
      scan_policy_line "${display_file}" "${line_number}" "${line}" 0

      if [[ "${active_lower}" =~ ^[[:space:]]*(paths|paths-ignore)[[:space:]]*: ]]; then
        add_issue "${display_file}" "${line_number}" "path-filtered workflow trigger can skip acceptance gates"
      fi
    fi

    if [[ "${line}" =~ ^[[:space:]]*-[[:space:]]+[A-Za-z_][A-Za-z0-9_-]*: ]]; then
      if (( in_step )); then
        scan_workflow_step "${display_file}" "${step_start}" "${step_text}"
      fi

      in_step=1
      step_start="${line_number}"
      step_text="${line}"$'\n'
    elif (( in_step )); then
      step_text+="${line}"$'\n'
    fi
  done < "${file}"

  if (( in_step )); then
    scan_workflow_step "${display_file}" "${step_start}" "${step_text}"
  fi
}

function scan_run_file {
  local run_file="$1"
  local display_file="$1"
  local line
  local line_number=0
  local in_function=0
  local function_name=""

  while IFS= read -r line || [[ -n "${line}" ]]; do
    line_number=$((line_number + 1))

    if [[ "${line}" =~ ^[[:space:]]*function[[:space:]]+([A-Za-z_][A-Za-z0-9_:-]*)[[:space:]]*\{ ]]; then
      in_function=1
      function_name="${BASH_REMATCH[1]}"
      continue
    fi

    if (( in_function )) && [[ "${line}" =~ ^[[:space:]]*\} ]]; then
      in_function=0
      function_name=""
      continue
    fi

    if (( in_function )) && value_in_list "${function_name}" "${REACHABLE_FUNCTIONS[@]}"; then
      scan_policy_line "${display_file}" "${line_number}" "${line}" 0

      if [[ "${function_name}" == "ci:run-all" ]] && [[ "$(clean_line "${line}")" =~ ci:run-all ]]; then
        add_issue "${display_file}" "${line_number}" "ci:run-all must not recursively call itself"
      fi
    fi
  done < "${run_file}"
}

function check_required_gate_presence {
  local gate

  for gate in "${REQUIRED_GATES[@]}"; do
    if ! text_has_exact_gate "${WORKFLOW_ACTIVE_TEXT}" "${gate}"; then
      add_issue ".github/workflows" "0" "missing required workflow call: ./run ${gate}"
    fi
  done
}

function check_project {
  local root="$1"
  local run_file="$2"
  local workflow_dir="$3"
  local workflow_file

  ISSUES=()
  REQUIRED_GATES=()
  WORKFLOW_ACTIVE_TEXT=""

  if [[ ! -f "${run_file}" ]]; then
    add_issue "${run_file}" "0" "run file not found"
  else
    collect_function_names "${run_file}"
    collect_reachable_functions "${run_file}"
    collect_required_gates "${run_file}"
    scan_run_file "${run_file}"
  fi

  if [[ ! -d "${workflow_dir}" ]]; then
    add_issue "${workflow_dir}" "0" "workflow directory not found"
  else
    while IFS= read -r workflow_file; do
      [[ -n "${workflow_file}" ]] || continue
      scan_workflow_file "${workflow_file}"
      scan_workflow_job_legibility "${workflow_file}"
    done < <(find "${workflow_dir}" -maxdepth 1 -type f \( -name '*.yml' -o -name '*.yaml' \) -print | sort)
  fi

  check_required_gate_presence

  if ((${#ISSUES[@]} > 0)); then
    printf "acceptance-gate-bypass-check failed for %s\n" "${root}"
    printf "  %s\n" "${ISSUES[@]}"
    return 1
  fi

  printf "acceptance-gate-bypass-check passed for %s\n" "${root}"
}

function fixture_run_file {
  local fixture_root="$1"
  local case_dir="$2"

  if [[ -f "${case_dir}/run" ]]; then
    printf "%s" "${case_dir}/run"
  else
    printf "%s" "${fixture_root}/fixture-run-stubs/run"
  fi
}

function check_root_run_file {
  local root="$1"
  local shared_run="${root}/../../fixture-run-stubs/run"

  if [[ -f "${root}/run" ]]; then
    printf "%s" "${root}/run"
  elif [[ -f "${shared_run}" ]]; then
    printf "%s" "${shared_run}"
  else
    printf "%s" "${root}/run"
  fi
}

function run_fixture_tests {
  local fixture_root="$1"
  local expected
  local case_dir
  local run_file
  local workflow_dir
  local output
  local status
  local failures=0

  for expected in pass fail; do
    for case_dir in "${fixture_root}/${expected}"/*; do
      [[ -d "${case_dir}" ]] || continue

      run_file="$(fixture_run_file "${fixture_root}" "${case_dir}")"
      workflow_dir="${case_dir}/.github/workflows"

      if output="$(check_project "${case_dir}" "${run_file}" "${workflow_dir}" 2>&1)"; then
        status=0
      else
        status=$?
      fi

      if [[ "${expected}" == "pass" && "${status}" -eq 0 ]]; then
        printf "ok: %s exited 0\n" "${case_dir#"${fixture_root}"/}"
      elif [[ "${expected}" == "fail" && "${status}" -ne 0 ]]; then
        printf "ok: %s rejected with exit %s\n" "${case_dir#"${fixture_root}"/}" "${status}"
      else
        failures=$((failures + 1))
        printf "not ok: %s expected %s, got exit %s\n" "${case_dir#"${fixture_root}"/}" "${expected}" "${status}"
        printf "%s\n" "${output}"
      fi
    done
  done

  if (( failures > 0 )); then
    printf "fixture verification failed: %s case(s) unexpected\n" "${failures}"
    return 1
  fi

  printf "fixture verification passed\n"
}

case "${1:-}" in
  "")
    check_project "." "run" ".github/workflows"
    ;;
  --check)
    if [[ $# -ne 2 ]]; then
      usage
      exit 2
    fi

    check_project "$2" "$(check_root_run_file "$2")" "$2/.github/workflows"
    ;;
  --test-fixtures)
    if [[ $# -gt 2 ]]; then
      usage
      exit 2
    fi

