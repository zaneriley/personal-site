<%!-- Case study, blocked out. Clay before chisel: the real text is in place,
     grey boxes stand in for media that has no design yet. The page places
     its blocks on the reading grid at three widths (see _case-study.css):
     column (prose), wide (the content cap) and full (the viewport). --%>
<article class="case-study">
  <%!-- Spacing: every gap is ink to ink (Typography trims each text block)
       and has one of four jobs, each double the last: pair, item, group,
       block. See _case-study.css. --%>
  <div class="cs-intro cs-column">
    <header class="cs-title">
      <.typography
        locale={@user_locale}
        tag="p"
        size="1xs"
        font="cheee"
        class="cs-eyebrow"
      >
        <.link navigate={~p"/#{@user_locale}/work"}>{gettext("Case study")}</.link>
        <span aria-hidden="true">›</span>
        {@translations["company"] || @project.company}
      </.typography>
      <.typography
        locale={@user_locale}
        tag="h1"
        size="4xl"
        font="cardinal"
      >
        {@translations["title"] || @project.title}
      </.typography>
      <.typography locale={@user_locale} tag="p" size="1xl">
        {@translations["introduction"] || @project.introduction}
      </.typography>
    </header>

    <div class="cs-facts-group">
      <dl class="cs-facts">
        <div class="cs-fact">
          <.typography locale={@user_locale} tag="dt" size="1xs" font="cheee">
            {gettext("Role")}
          </.typography>
          <.typography locale={@user_locale} tag="dd">
            {@translations["role"] || @project.role}
          </.typography>
        </div>
        <% platforms = @translations["platforms"] || @project.platforms || [] %>
        <div class="cs-fact">
          <.typography locale={@user_locale} tag="dt" size="1xs" font="cheee">
            {gettext("Timeline")}
          </.typography>
          <.typography locale={@user_locale} tag="dd">
            {@translations["timeline"] || @project.timeline}
          </.typography>
        </div>
        <div class="cs-fact">
          <.typography locale={@user_locale} tag="dt" size="1xs" font="cheee">
            {ngettext("Platform", "Platforms", length(platforms))}
          </.typography>
          <.typography locale={@user_locale} tag="dd">
            {Enum.join(platforms, " · ")}
          </.typography>
        </div>
      </dl>
      <.content_metadata
        read_time={@translations["read_time"] || @project.read_time}
        word_count={@translations["word_count"] || @project.word_count}
        updated_at={@translations["updated_at"] || @project.updated_at}
        user_locale={@user_locale}
      />
    </div>
  </div>

  <div
    class="cs-hero cs-wide blockout"
    style={"--vt-hero: project-hero-#{@project.url}"}
    aria-hidden="true"
  >
    <span>hero · finished product · 16:9</span>
  </div>

  <div class="cs-body">
    <aside class="cs-rail blockout" aria-hidden="true">
      <span>contents</span>
    </aside>

    <div class="cs-story">
      <%= if @translations["content"] do %>
        {render_to_safe(@translations["content"])}
      <% else %>
        {render_to_safe(@body_ast)}
      <% end %>
    </div>
  </div>

  <div class="cs-wide blockout cs-media-wide" aria-hidden="true">
    <span>wide media · 3:2</span>
  </div>

  <.link
    :if={@next_project}
    navigate={~p"/#{@user_locale}/work/#{@next_project.url}"}
    class="cs-next bleed"
  >
    <span
      class="cs-next-media blockout"
      data-vt-hero={"project-hero-#{@next_project.url}"}
      aria-hidden="true"
    >
      <span>next project · full bleed</span>
    </span>
    <span class="cs-next-title reading-grid">
      <.typography
        locale={@user_locale}
        tag="span"
        size="3xl"
        font="cardinal"
      >
        {@next_project.translations["title"] || @next_project.title}
      </.typography>
    </span>
  </.link>
</article>
