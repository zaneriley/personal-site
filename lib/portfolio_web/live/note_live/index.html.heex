<.header>
  {ngettext("Note", "Notes", 2)}
</.header>

<%!-- The same list as Work. The generated table that was here was wider
     than a phone screen, which widened the page and made the browser cancel
     the page transition into Notes. --%>
<.portfolio_item_list
  items={@streams.notes}
  navigate_to={fn item -> ~p"/#{@user_locale}/note/#{item.url}" end}
  user_locale={@user_locale}
/>

<.live_component
  :if={@live_action in [:new, :edit]}
  module={PortfolioWeb.NoteLive.FormComponent}
  id={@note.id || :new}
  title={@page_title}
  action={@live_action}
  note={@note}
  patch={~p"/#{@user_locale}/notes"}
  show
  on_cancel={JS.patch(~p"/#{@user_locale}/notes")}
/>
