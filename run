function ci:performance-browser {
    local docker_env_args=()
    local image
    local output
    local tmp_output
    local status

    image="${PERF_BROWSER_IMAGE:-personal-site-browser-performance}"
    output="${PERF_BROWSER_OUTPUT:-.tmp/ci-artifacts/prod-build/browser-performance-last-run.json}"
    tmp_output="$(mktemp)"

    if [[ -n "${PERF_BROWSER_BASE_URL:-}" ]]; then
        docker_env_args+=(-e "PERF_BROWSER_BASE_URL=${PERF_BROWSER_BASE_URL}")
    fi

    if [[ -n "${PERF_BROWSER_ROUTES_CONTRACT:-}" ]]; then
        docker_env_args+=(-e "PERF_BROWSER_ROUTES_CONTRACT=${PERF_BROWSER_ROUTES_CONTRACT}")
    fi

    if [[ -n "${PROD_BUILD_APP_SHA:-}" ]]; then
        docker_env_args+=(-e "PROD_BUILD_APP_SHA=${PROD_BUILD_APP_SHA}")
    fi

    if docker build --target browser -t "${image}" . >/dev/null &&
        docker run --rm "${docker_env_args[@]}" "${image}" node ../ci/gates/browser-performance.mjs --output - > "${tmp_output}" &&
        jq -e '.status == "pass"' "${tmp_output}" >/dev/null; then
        mkdir -p "$(dirname "${output}")"
        mv "${tmp_output}" "${output}"
        echo "performance browser artifact written: ${output}"
        return 0
    else
        status=$?
    fi

    if [[ -s "${tmp_output}" ]]; then
        mkdir -p "$(dirname "${output}")"
        cp "${tmp_output}" "${output}"
        echo "performance browser artifact written: ${output}"
    fi

    rm -f "${tmp_output}"
    return "${status}"
}

function ci:preview-page-acceptance:test {
    local env_probe_dir
    local probe_status
    local check_image
    local entrypoint
    local image

    check_image="${PREVIEW_PAGE_ACCEPTANCE_IMAGE:-personal-site-preview-page-acceptance}"
    image="${PREVIEW_PAGE_ACCEPTANCE_TEST_IMAGE:-personal-site-preview-page-acceptance-test}"
    docker build --target preview-page-acceptance -t "${check_image}" . >/dev/null
    entrypoint="$(docker image inspect --format '{{json .Config.Entrypoint}}' "${check_image}")"
    if [[ "${entrypoint}" != '["node","/opt/preview-page-acceptance/preview-page-acceptance.mjs"]' ]]; then
        echo "fatal: preview-page-acceptance image entrypoint drifted: ${entrypoint}" >&2
        return 1
    fi
    docker run --rm \
        --entrypoint node \
        -v "${PWD}:/repo:ro" \
        "${check_image}" \
        --input-type=module \
        -e '
          import crypto from "node:crypto";
          import fs from "node:fs";

          const pairs = [
            ["/repo/ci/preview/preview-page-acceptance.mjs", "/opt/preview-page-acceptance/preview-page-acceptance.mjs"],
            ["/repo/ci/contracts/routes.json", "/opt/preview-page-acceptance/routes.json"],
            ...fs.readdirSync("/repo/ci/preview/preview-page-acceptance")
              .filter((name) => name.endsWith(".mjs"))
              .map((name) => [
                `/repo/ci/preview/preview-page-acceptance/${name}`,
                `/opt/preview-page-acceptance/preview-page-acceptance/${name}`,
              ]),
          ];

          function sha256(file) {
            return crypto.createHash("sha256").update(fs.readFileSync(file)).digest("hex");
          }

          for (const [source, packaged] of pairs) {
            if (sha256(source) !== sha256(packaged)) {
              throw new Error(`packaged preview checker drifted: ${packaged}`);
            }
          }
        '
    docker build --target browser -t "${image}" . >/dev/null
    docker run --rm --tmpfs /tmp:rw,size=256m "${image}" node /app/ci/preview/preview-page-acceptance-test.mjs

    mkdir -p .tmp/ci-artifacts
    env_probe_dir="$(mktemp -d "${PWD}/.tmp/ci-artifacts/preview-page-acceptance-env.XXXXXX")"
    set +o errexit
    PREVIEW_PAGE_ACCEPTANCE_IMAGE_REF="${check_image}" \
        PREVIEW_PAGE_ACCEPTANCE_OUTPUT_DIR="${env_probe_dir}" \
        PREVIEW_DEPLOY_ATTEMPT_ID="preview-page-acceptance-env-probe" \
        PREVIEW_DEPLOY_REDACT_PUBLIC_URLS=1 \
        ./run ci:preview-page-acceptance "http://127.0.0.1:9" "http://127.0.0.1:9" \
        >"${env_probe_dir}/stdout.log" 2>"${env_probe_dir}/stderr.log"
    probe_status="$?"
    set -o errexit
    if [[ "${probe_status}" == "0" ]]; then
        echo "fatal: preview-page-acceptance env probe unexpectedly passed against a dead port" >&2
        return 1
    fi
    jq -e \
        --arg attempt_id "preview-page-acceptance-env-probe" \
        --arg image_ref "${check_image}" \
        '.preview_deploy_attempt_id == $attempt_id
          and .preview_page_acceptance_image_ref == $image_ref' \
        "${env_probe_dir}/preview-page-acceptance.json" >/dev/null
}

function ci:preview-page-acceptance {
    local browser_connect_url
    local expected_site_origin
    local image
    local output_mount_dir
    local output_dir

    image="${PREVIEW_PAGE_ACCEPTANCE_IMAGE_REF:-${PREVIEW_PAGE_ACCEPTANCE_IMAGE:-personal-site-preview-page-acceptance}}"
    browser_connect_url="${PREVIEW_BROWSER_CONNECT_URL:-${1:-}}"
    expected_site_origin="${PREVIEW_EXPECTED_SITE_ORIGIN:-${2:-${browser_connect_url}}}"
    output_dir="${PREVIEW_PAGE_ACCEPTANCE_OUTPUT_DIR:-.tmp/ci-artifacts/preview-page-acceptance}"

    if [[ -z "${browser_connect_url}" ]]; then
        echo "Usage: PREVIEW_PAGE_ACCEPTANCE_IMAGE_REF=<trusted-preview-page-acceptance-image> ./run ci:preview-page-acceptance http://<preview-host>:<port> [expected-site-origin]" >&2
        return 1
    fi

    mkdir -p "${output_dir}"
    chmod ugo+rwx "${output_dir}"
    if [[ "${output_dir}" == /* ]]; then
        output_mount_dir="${output_dir}"
    else
        output_mount_dir="${PWD}/${output_dir}"
    fi

    docker run --rm \
        --init \
        --ipc=host \
        --tmpfs /tmp:rw,size=256m \
        -v "${output_mount_dir}:/artifacts" \
        -e "PREVIEW_DEPLOY_ATTEMPT_ID=${PREVIEW_DEPLOY_ATTEMPT_ID:-}" \
        -e "PREVIEW_DEPLOY_REDACT_PUBLIC_URLS=${PREVIEW_DEPLOY_REDACT_PUBLIC_URLS:-}" \
        -e "PREVIEW_PAGE_ACCEPTANCE_IMAGE_REF=${image}" \
        "${image}" \
        --browser-connect-url "${browser_connect_url}" \
        --expected-site-origin "${expected_site_origin}" \
        --routes-contract /opt/preview-page-acceptance/routes.json \
        --screenshots-dir /artifacts/screenshots \
        --output /artifacts/preview-page-acceptance.json \
        --failure-summary /artifacts/preview-page-acceptance.md
}

function ci:content-validate {
    content:validate "$@"
}

function ci:content-publication-flow {
    content:rehearse "$@"
}

function ci:run-all {
    local DC="run"

    ci:install-deps
    ci:workflow-lint
    ci:acceptance-gate-bypass-check
    ci:acceptance-gate-bypass-check:test
    ci:disposable-host-check
    ci:secret-scan
    ci:setup-env
    ci:compile
    ci:lint "$@"
    ci:security-check
    # ci:setup-db
    ci:test "$@"
    ci:static-analysis
}

function ci:format {
    # Check source formatting and frontend formatting/lint rules
    elixir:format:check
    js:fix:check
    css:lint:check
}

function ci:types {
    # Run static type analysis
    ci:static-analysis "$@"
}

function ci:security {
    # Run security checks
    ci:security-check "$@"
}

function ci:secrets {
    # Run secret scanning
    ci:secret-scan "$@"
}

function ci:workflow {
    # Lint GitHub workflow files
    ci:workflow-lint "$@"
}

function ci:performance {
    # Check public page performance budgets
    ci:performance-browser "$@"
}

function ci:content {
    # Validate publishable content through the app
    ci:content-validate "$@"
}

function ci:release {
    # Prove the release-shaped production build gate
    ci:prod-build "$@"
}

function ci:gate-integrity {
    # Check that acceptance gates have not been bypassed
    ci:acceptance-gate-bypass-check "$@"
}

function ci:all {
    # Run the full local CI aggregate
    ci:run-all "$@"
}

# -----------------------------------------------------------------------------
# Human-facing deploy commands
# -----------------------------------------------------------------------------

function deploy:preview {
    # Create and verify one private preview
    preview:deploy "$@"
}

function deploy:preview:create {
    # Create and verify one private preview
    preview:deploy "$@"
}

function deploy:preview:destroy {
    # Destroy a private preview from its deploy receipt
    preview:destroy "$@"
}

function deploy:preview:cleanup {
    # Destroy expired leased previews
    preview:sweep-expired "$@"
}

function deploy:publication {
    # Rehearse the content publication flow locally
    content:rehearse "$@"
}

function deploy:publication:preview {
    # Rehearse content publication against a running private preview
    content:rehearse-preview "$@"
}

function deploy:content:status {
    # Print the app-owned content publication status
    content:status "$@"
}

function deploy:content:rollback {
    # Roll back live content to a known-good publication generation
    content:rollback "$@"
}

function deploy:release {
    # Prove the release-shaped build gate; does not promote the origin
    ci:prod-build "$@"
}

# -----------------------------------------------------------------------------
# Debug commands for implementation internals
# -----------------------------------------------------------------------------

function debug:preview-host:create {
    # Create a disposable preview host directly
    host:disposable:create "$@"
}

function debug:preview-host:status {
    # Print disposable preview host status directly
    host:disposable:status "$@"
}

function debug:preview-host:destroy {
    # Destroy a disposable preview host directly
    host:disposable:destroy "$@"
}

function debug:preview-runtime {
    # Run the lower-level preview runtime viability check
    host:disposable:runtime-viability "$@"
}

function debug:preview-artifacts {
    # Scan private preview artifacts before upload
    preview:artifact-safety "$@"
}

# -----------------------------------------------------------------------------
# Unified commands
# -----------------------------------------------------------------------------

function lint:all {
    elixir:lint
    js:lint "$@"
    css:lint
}

function format:all {
    elixir:format
    js:fix "$@"
    css:lint
}

function test:all {
    elixir:test "$@"
    js:test
}

function help {
  cat <<'EOF'
./run <task> [args]

Dev: local app work
  dev:setup             Prepare local env, containers, and Postgres
  dev:start             Start the local Docker Compose app stack
  dev:stop              Stop the local Docker Compose app stack
  dev:logs              Follow Docker Compose logs
  dev:shell             Shell in the web container
  dev:console           IEx in the web container
  dev:db                PostgreSQL shell
  dev:secret            Generate a Phoenix secret
  dev:clean             Remove generated local static assets
  dev:format            Format Elixir, JS, and CSS sources
  dev:lint              Run local lint fixers
  dev:test              Run local Elixir and JS tests
  dev:deps:install      Install Elixir and JS dependencies
  dev:deps:outdated     List outdated Elixir and JS dependencies

CI: prove repo state
  ci:format             Check formatting and frontend style rules
  ci:lint               Run lint gate
  ci:test               Run Elixir and JS test gates
  ci:types              Run static type analysis
  ci:security           Run security checks
  ci:secrets            Run secret scanning
  ci:workflow           Lint GitHub workflow files
  ci:performance        Check public page performance budgets
  ci:content            Validate publishable content through the app
  ci:release            Prove the release-shaped production build gate
  ci:gate-integrity     Check that acceptance gates have not been bypassed
  ci:all                Run the full local CI aggregate

Deploy: preview, publication, content state, and release proof
  deploy:preview        Create and verify one private preview
  deploy:preview:create Alias for deploy:preview
  deploy:preview:destroy
                        Destroy a private preview from its deploy receipt
  deploy:preview:cleanup
                        Destroy expired leased previews
  deploy:publication    Rehearse the content publication flow locally
  deploy:publication:preview
                        Rehearse publication against a private preview
  deploy:content:status Print app-owned content publication status
  deploy:content:rollback
                        Roll back live content to a known-good generation
  deploy:release        Prove release build gate; does not promote origin

Debug: implementation internals
  debug:preview-host:create
  debug:preview-host:status
  debug:preview-host:destroy
  debug:preview-runtime
  debug:preview-artifacts

Compatibility aliases still exist for older commands. Use ./run help:all to list every callable task.
EOF
}

function help:all {
  printf "%s <task> [args]\n\nAll callable tasks:\n" "${0}"

  compgen -A function | grep -v "^_" | sort | cat -n
}

# This idea is heavily inspired by: https://github.com/adriancooney/Taskfile
TIMEFORMAT=$'\nTask completed in %3lR'
time "${@:-help}"
