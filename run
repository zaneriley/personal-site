# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

function psql {
  # Connect to PostgreSQL
  # shellcheck disable=SC1091
  . .env
 _dc postgres psql -U "${POSTGRES_USER}" "${@}"
}

function prod:migrate {
  # Run database migrations in production
  cmd bin/portfolio eval "Portfolio.Release.migrate"
}

function prod:remote {
  # Connect an IEx session to your production system
  cmd bin/portfolio remote
}

function release {
  # Build and tag the Docker image
  docker build --no-cache -t portfolio:"$(git rev-parse --short HEAD) ."

  # Push to Docker registry (uncomment and modify as needed)
  # docker push your-registry/portfolio:$(git rev-parse --short HEAD)

  echo "Release $(git rev-parse --short HEAD) built and ready for deployment"
}

function clean {
  # Remove cache and other machine generates files
  rm -rf priv/static/*.* priv/static/js priv/static/css priv/static/images priv/static/fonts
  touch priv/static/.keep
}

# -----------------------------------------------------------------------------
# CI
# -----------------------------------------------------------------------------

function ci:install-deps {
    if command -v apt-get >/dev/null 2>&1; then
        sudo apt-get update
        sudo apt-get install -y curl jq shellcheck
        return 0
    fi

    echo "apt-get unavailable; using local tools or repository container fallbacks"
}

function ci:setup-env {
    if [[ ! -e .env ]]; then
        cp .env.example .env
    fi

    docker compose build
    docker compose up -d postgres

    # shellcheck disable=SC1091
    . .env
    _apply_ci_docker_volume_overrides

    local attempts=60
    until docker compose exec -T \
        -e "PGPASSWORD=${POSTGRES_PASSWORD}" postgres \
        psql -U "${POSTGRES_USER}" "${POSTGRES_USER}" -c 'SELECT 1'; do
        attempts=$((attempts - 1))
        if [[ "${attempts}" -le 0 ]]; then
            echo "Postgres did not become ready"
            return 1
        fi

        sleep 1
    done

    docker compose ps
}

function ci:compile {
    mix compile --force --warnings-as-errors
}

function ci:workflow-lint {
    local workflow
    local workflows=()

    while IFS= read -r -d '' workflow; do
        workflows+=("${workflow}")
    done < <(find .github/workflows -maxdepth 1 -type f \( -name '*.yml' -o -name '*.yaml' \) -print0)

    if [[ "${#workflows[@]}" -eq 0 ]]; then
        echo "No GitHub workflow files found"
        return 1
    fi

    bin/ci/actionlint "${workflows[@]}"
}

function ci:url-discipline {
    local url_wrap_matches
    local csp_env_matches

    url_wrap_matches="$(rg --line-number '\burl\(~p' lib/portfolio_web/ || true)"

    if [[ -n "${url_wrap_matches}" ]]; then
        echo "Do not wrap verified routes with url(~p...) in web code." >&2
        echo "Use ~p for root-relative in-app paths, or absolute_url(~p...) when an absolute site URL is required." >&2
        printf "%s\n" "${url_wrap_matches}" >&2
        return 1
    fi

    csp_env_matches="$(rg --line-number 'URL_SCHEME|URL_PORT' lib/portfolio_web/plugs/ || true)"

    if [[ -n "${csp_env_matches}" ]]; then
        echo "CSP must derive scheme/port from conn, not URL_SCHEME / URL_PORT env vars." >&2
        printf "%s\n" "${csp_env_matches}" >&2
        return 1
    fi
}

function ci:lint {
    ci:url-discipline
    lint:shell
    lint:dockerfile "${@}"
    elixir:lint
    elixir:format:check
    js:fix:check
    css:lint:check
}

