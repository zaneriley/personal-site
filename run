# -----------------------------------------------------------------------------
# CI
# -----------------------------------------------------------------------------

function ci:install-deps {
    if command -v apt-get >/dev/null 2>&1; then
        sudo apt-get update
        sudo apt-get install -y curl jq shellcheck
        return 0
    fi

    echo "apt-get unavailable; using local tools or repository container fallbacks"
}

function ci:setup-env {
    if [[ ! -e .env ]]; then
        cp .env.example .env
    fi

    docker compose build
    docker compose up -d postgres

    # shellcheck disable=SC1091
    . .env
    _apply_ci_docker_volume_overrides

    local attempts=60
    until docker compose exec -T \
        -e "PGPASSWORD=${POSTGRES_PASSWORD}" postgres \
        psql -U "${POSTGRES_USER}" "${POSTGRES_USER}" -c 'SELECT 1'; do
        attempts=$((attempts - 1))
        if [[ "${attempts}" -le 0 ]]; then
            echo "Postgres did not become ready"
            return 1
        fi

        sleep 1
    done

    docker compose ps
}

function ci:compile {
    mix compile --force --warnings-as-errors
}

function ci:workflow-lint {
    local workflow
    local workflows=()

    while IFS= read -r -d '' workflow; do
        workflows+=("${workflow}")
    done < <(find .github/workflows -maxdepth 1 -type f \( -name '*.yml' -o -name '*.yaml' \) -print0)

    if [[ "${#workflows[@]}" -eq 0 ]]; then
        echo "No GitHub workflow files found"
        return 1
    fi

    bin/ci/actionlint "${workflows[@]}"
}

function ci:url-discipline {
    local rg_status
    local -a url_wrap_command
    local -a csp_env_command
    local url_wrap_matches
    local csp_env_matches

    if command -v rg >/dev/null 2>&1; then
        url_wrap_command=(rg --line-number '\burl\(~p' lib/portfolio_web/)
        csp_env_command=(rg --line-number 'URL_SCHEME|URL_PORT' lib/portfolio_web/plugs/)
    else
        url_wrap_command=(grep -RInE '(^|[^[:alnum:]_])url\(~p' lib/portfolio_web/)
        csp_env_command=(grep -RInE 'URL_SCHEME|URL_PORT' lib/portfolio_web/plugs/)
    fi

    if url_wrap_matches="$("${url_wrap_command[@]}")"; then
        :
    else
        rg_status="$?"
        if [[ "${rg_status}" -eq 1 ]]; then
            url_wrap_matches=""
        else
            return "${rg_status}"
        fi
    fi

    if [[ -n "${url_wrap_matches}" ]]; then
        echo "Do not wrap verified routes with url(~p...) in web code." >&2
        echo "Use ~p for root-relative in-app paths, or absolute_url(~p...) when an absolute site URL is required." >&2
        printf "%s\n" "${url_wrap_matches}" >&2
        return 1
    fi

    if csp_env_matches="$("${csp_env_command[@]}")"; then
        :
    else
        rg_status="$?"
        if [[ "${rg_status}" -eq 1 ]]; then
            csp_env_matches=""
        else
            return "${rg_status}"
        fi
    fi

    if [[ -n "${csp_env_matches}" ]]; then
        echo "CSP must derive scheme/port from conn, not URL_SCHEME / URL_PORT env vars." >&2
        printf "%s\n" "${csp_env_matches}" >&2
        return 1
    fi
}

