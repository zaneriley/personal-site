function ci:prod-build {
    ci/gates/prod-build.sh
}

function ci:performance-browser {
    local output
    local tmp_output
    local status

    output="${PERF_BROWSER_OUTPUT:-.tmp/ci-artifacts/prod-build/browser-performance-last-run.json}"
    tmp_output="$(mktemp)"

    if docker compose build js >/dev/null &&
        docker compose run --rm ${TTY} js node ../ci/gates/browser-performance.mjs --output - > "${tmp_output}" &&
        jq -e '.status == "pass"' "${tmp_output}" >/dev/null; then
        mkdir -p "$(dirname "${output}")"
        mv "${tmp_output}" "${output}"
        echo "performance browser artifact written: ${output}"
        return 0
    else
        status=$?
    fi

    if [[ -s "${tmp_output}" ]]; then
        mkdir -p "$(dirname "${output}")"
        cp "${tmp_output}" "${output}"
        echo "performance browser artifact written: ${output}"
    fi

    rm -f "${tmp_output}"
    return "${status}"
}

function ci:preview-page-acceptance:test {
    local check_image
    local image

    check_image="${PREVIEW_PAGE_ACCEPTANCE_IMAGE:-personal-site-preview-page-acceptance}"
    image="${PREVIEW_PAGE_ACCEPTANCE_TEST_IMAGE:-personal-site-preview-page-acceptance-test}"
    docker build --target preview-page-acceptance -t "${check_image}" . >/dev/null
    docker build --target browser -t "${image}" . >/dev/null
    docker run --rm --tmpfs /tmp:rw,size=256m "${image}" node /app/ci/preview/preview-page-acceptance-test.mjs
}

function ci:preview-page-acceptance {
    local browser_connect_url
    local expected_site_origin
    local image
    local output_dir

    image="${PREVIEW_PAGE_ACCEPTANCE_IMAGE_REF:-${PREVIEW_PAGE_ACCEPTANCE_IMAGE:-personal-site-preview-page-acceptance}}"
    browser_connect_url="${PREVIEW_BROWSER_CONNECT_URL:-${1:-}}"
    expected_site_origin="${PREVIEW_EXPECTED_SITE_ORIGIN:-${2:-${browser_connect_url}}}"
    output_dir="${PREVIEW_PAGE_ACCEPTANCE_OUTPUT_DIR:-.tmp/ci-artifacts/preview-page-acceptance}"

    if [[ -z "${browser_connect_url}" ]]; then
        echo "Usage: PREVIEW_PAGE_ACCEPTANCE_IMAGE_REF=ghcr.io/owner/repo@sha256:<digest> ./run ci:preview-page-acceptance http://<preview-host>:<port> [expected-site-origin]" >&2
        return 1
    fi

    if [[ -n "${PREVIEW_PAGE_ACCEPTANCE_IMAGE_REF:-}" && ! "${PREVIEW_PAGE_ACCEPTANCE_IMAGE_REF}" =~ @sha256:[0-9a-fA-F]{64}$ ]]; then
        echo "fatal: PREVIEW_PAGE_ACCEPTANCE_IMAGE_REF must be digest-pinned with @sha256:<64 hex chars>" >&2
        return 1
    fi

    mkdir -p "${output_dir}"

    docker run --rm \
        --init \
        --ipc=host \
        --tmpfs /tmp:rw,size=256m \
        -v "${PWD}/${output_dir}:/artifacts" \
        "${image}" \
        --browser-connect-url "${browser_connect_url}" \
        --expected-site-origin "${expected_site_origin}" \
        --routes-contract /opt/preview-page-acceptance/routes.json \
        --screenshots-dir /artifacts/screenshots \
        --output /artifacts/preview-page-acceptance.json \
        --failure-summary /artifacts/preview-page-acceptance.md
}

function ci:content-validate {
    content:validate "$@"
}

function ci:run-all {
    local DC="run"

    ci:install-deps
    ci:workflow-lint
    ci:acceptance-gate-bypass-check
    ci:acceptance-gate-bypass-check:test
    ci:disposable-host-check
    ci:secret-scan
    ci:setup-env
    ci:compile
    ci:lint "$@"
    ci:security-check
    # ci:setup-db
    ci:test "$@"
    ci:static-analysis
}

# -----------------------------------------------------------------------------
# Unified commands
# -----------------------------------------------------------------------------

function lint:all {
    elixir:lint
    js:lint "$@"
    css:lint
}

function format:all {
    elixir:format
    js:fix "$@"
    css:lint
}

function test:all {
    elixir:test "$@"
    js:test
}

function help {
  printf "%s <task> [args]\n\nTasks:\n" "${0}"

  compgen -A function | grep -v "^_" | cat -n

  printf "\nExtended help:\n  Each task has comments for general usage\n"
}

# This idea is heavily inspired by: https://github.com/adriancooney/Taskfile
TIMEFORMAT=$'\nTask completed in %3lR'
time "${@:-help}"
