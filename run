function ci:secret-scan {
    local scan_dir
    local status

    scan_dir="$(mktemp -d)"

    git ls-files -z --cached --others --exclude-standard | while IFS= read -r -d '' path; do
        if [[ -f "${path}" ]]; then
            mkdir -p "${scan_dir}/$(dirname "${path}")"
            cp "${path}" "${scan_dir}/${path}"
        fi
    done

    if gitleaks dir "${scan_dir}" --redact --exit-code 1; then
        status=0
    else
        status=$?
    fi

    rm -rf "${scan_dir}"
    return "${status}"
}

